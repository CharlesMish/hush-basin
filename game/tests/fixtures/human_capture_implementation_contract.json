    },
    {
      "path": "tools/validate_human_feasibility_evidence.py",
      "purpose": "standard-library validation of schemas, metrics, hashes, sequence, and deterministic replay"
    },
    {
      "path": "evidence/v1_2_5_capture_implementation_manifest.json",
      "purpose": "Codex-generated raw hashes and exact-engine parse/import proof for the implementation"
    },
    {
      "path": "tests/p1a_runtime_runner.gd",
      "purpose": "add NORMALIZED_INPUT_TRACE_REPLAY_V1 support without changing other vectors"
    },
    {
      "path": "tools/run_p1a_runtime_suite.py",
      "purpose": "resolve selected traces for A1/A2/X0 and preserve the other 37 vectors"
    }
  ],
  "runner_cli": {
    "capture_only_flags": [
      "--attempt-index"
    ],
    "replay_only_flags": [
      "--input-trace",
      "--replay-index"
    ],
    "required_flags": [
      "--mode",
      "--route",
      "--output-dir",
      "--session-id"
