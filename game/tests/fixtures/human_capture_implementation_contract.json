  "capture_tick_order": [
    "read normalized player inputs at the start of vector physics tick",
    "record the exact integer input record",
    "apply only those normal inputs through the existing input system",
    "advance frozen craft physics",
    "record post-physics state and events with the same vector_tick"
  ],
  "evidence_packaging": {
    "every_terminal_path_requires_standalone_zip": true,
    "finalize_before_disposable_cleanup": true,
    "forbidden_entries": [
      ".godot",
      "__MACOSX",
      "._*",
      ".DS_Store",
      "editor state",
      "nested archives",
      "unretained logs"
    ],
    "retain_all_familiarization_session metadata and all recorded attempts": true,
    "root_checksum_file": "SHA256SUMS.txt"
  },
  "forbidden_assistance": [
    "automatic steering",
    "automatic braking",
    "route-following input generation",
    "aim assist",
    "ideal-line display",
    "live lateral or chainage coaching",
    "transform/position/velocity/physics-state writes after tick zero"
  ],
  "implementation_acceptance": [
    "exact Godot import and --check-only parse pass",
    "C1 maximum delta 0.0 with instrumentation inactive",
    "schemas and raw-byte hashes emitted",
    "all attempts retained",
    "three exact replay repetitions",
    "zero post-result events",
    "no forbidden gameplay/world deltas"
  ],
  "permitted_setup_writes": [
    "canonical spawn transform before tick zero",
    "zero initial linear velocity before tick zero",
    "frozen initial DRIVE fold state before tick zero",
    "physics disabled during ready countdown"
  ],
  "required_files": [
    {
      "path": "tests/p1a_human_feasibility_runner.gd",
      "purpose": "visible unassisted familiarization and capture; headless deterministic replay from canonical state"
    },
    {
      "path": "tools/run_human_feasibility_session.py",
