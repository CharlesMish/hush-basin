        "required": [
          "chainage_mm",
          "fast_distance_mm",
          "fold_u6",
          "lateral_mm",
          "physics_tick",
          "position_mm",
          "surface_class",
          "vector_tick",
          "velocity_mmps",
          "yaw_urad"
